# --- Upstream core checkout (fetched by tools/ta.py bootstrap, never committed) ---
.acore/
build/
dist/

# --- Local environment ---
.env
*.local
local.json

# --- Server runtime artifacts ---
*.log
*.pid
logs/
var/

# --- Client data extracted from a WoW install (huge, licensed, never commit) ---
data/client/
*.mpq
*.dbc
*.vmtree
*.vmtile
*.mmtile
*.map

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Website (web/) ---
node_modules/
.next/
# Regenerated by `next build`; it references files inside .next/, so committing
# it would break a typecheck on a fresh clone.
next-env.d.ts
*.tsbuildinfo

# --- Launcher (launcher/) ---
launcher/core/target/
launcher/src-tauri/target/
# tauri-build regenerates the ACL schemas from capabilities/ on every build.
launcher/src-tauri/gen/
launcher/ui/dist/
# Cargo.lock IS committed for the launcher: it ships as a signed binary to
# players, so the exact dependency set has to be reproducible from the tag.

# --- Python ---
__pycache__/
*.pyc

# --- Website example dependencies ---
node_modules/
package-lock.json
# ...except the launcher's, which ships as a binary to players: the exact
# dependency set has to be reproducible from the tag that built it, and the
# release workflow runs `npm ci`, which fails outright without a lockfile.
!launcher/package-lock.json
!launcher/ui/package-lock.json
