#
# Tomorrow's Ash - Classless Module Configuration
#
# Copy this file to your worldserver config directory as `mod_classless.conf`
# and edit it there. This .dist file is the tracked default; the server reads
# the .conf if present, otherwise falls back to this .dist.
#

[worldserver]

#
#    Classless.Enable
#        Description: Master switch for the classless system.
#                     When 0, the module registers itself but changes no
#                     gameplay behaviour whatsoever - the server behaves as
#                     stock AzerothCore. Every other setting in this file is
#                     ignored while this is 0.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

#        Phase 1: enabling this makes the Ashmorrow Ability Broker functional.
#                 Spawn one with `.npc add 900000` in-game. Abilities come from
#                 the `classless_tree` / `classless_node` tables - no recompile
#                 is needed to change them.

Classless.Enable = 0

#
#    Classless.Announce
#        Description: Send a message to players on login telling them the
#                     classless module is active on this realm.
#        Default:     1 - (Enabled)

Classless.Announce = 1

#
#    Classless.SuppressBlizzardTalents
#        Description: Set the player's Blizzard talent-point budget to zero,
#                     which empties the built-in talent frame. Used when the
#                     classless skill-point system fully replaces talents.
#
#                     NOTE: This is applied through the OnPlayerCalculateTalentsPoints
#                     hook, so it needs no core modification. It does NOT refund
#                     already-spent talent points - run `.reset talents` or the
#                     module's migration command for existing characters.
#
#                     Phase 2 feature. Leave at 0 until the skill-point system
#                     that replaces talents actually exists, or characters will
#                     have no way to spend points at all.
#        Default:     0 - (Disabled, Blizzard talents work normally)
#                     1 - (Enabled, talent frame is emptied)

Classless.SuppressBlizzardTalents = 0

#
#    Classless.Points.FirstLevel
#        Description: The level at which a character starts earning skill
#                     points. Below this they earn none.
#
#                     Blizzard's talent system starts at level 10; matching it
#                     keeps the early levels uncluttered.
#        Default:     10

Classless.Points.FirstLevel = 10

#
#    Classless.Points.PerLevel
#        Description: Skill points earned per level, from FirstLevel onward.
#
#                     The budget is DERIVED from level, never stored, so
#                     changing this re-prices every character immediately with
#                     no migration. Characters already over budget are not
#                     force-respecced - they simply cannot buy more until they
#                     respec or out-level the deficit.
#        Default:     1

Classless.Points.PerLevel = 1

#
#    Classless.Points.Bonus
#        Description: Flat extra points granted to every character, on top of
#                     the level curve. A blunt instrument for opening up the
#                     early game during testing.
#        Default:     0

Classless.Points.Bonus = 0

#
#    Classless.Respec.Cost
#        Description: Cost in COPPER to reset all classless abilities and
#                     refund every point. 0 = free.
#                     (1 gold = 10000 copper.)
#        Default:     0

Classless.Respec.Cost = 0

#
#    Classless.OpenRelicSlot
#        Description: Let any body type equip librams, idols, totems and
#                     sigils.
#
#                     Relics are the one gear category the Phase 3 SQL pass
#                     cannot open. Their equip slot is chosen by a hardcoded
#                     class check in Player::FindEquipSlot, so clearing
#                     AllowableClass on them does nothing. This setting turns
#                     on a module hook (OnPlayerIsClass, scoped to
#                     CLASS_CONTEXT_EQUIP_RELIC only) that answers that one
#                     check.
#
#                     It does NOT touch armor proficiency, talents, stats,
#                     pets, class trainers or anything else class-dependent -
#                     the hook returns "no opinion" for every other context.
#
#                     A character still has only one relic slot, and a relic
#                     that buffs a spell they have not learned does nothing.
#        Default:     0 - (Disabled, stock behaviour)
#                     1 - (Enabled)

Classless.OpenRelicSlot = 0

#    Classless.Chassis.HunterPets
#        Description: May the Skirmisher body type tame and keep a hunter pet?
#
#                     Skirmisher is built on the Hunter class id (3) rather
#                     than Shaman (7), because that is the only chassis triple
#                     in which every playable race has at least one body type
#                     available - Night Elf has none otherwise. See
#                     docs/decisions/0008-body-type-client-patch.md §10.
#
#                     That swap must not hand one body type a companion the
#                     other two cannot have. Before it, nobody on this realm
#                     could tame anything; leaving this at 0 keeps it that way,
#                     so the swap changes who can play what and nothing else.
#
#                     Applied through the OnPlayerIsClass hook against
#                     CLASS_CONTEXT_PET, so it needs no core modification: the
#                     stable master declines, and taming fails.
#
#                     Set to 1 only alongside a decision that pets belong to
#                     EVERY body type, with the taming abilities placed in the
#                     ability trees. A pet only Skirmishers can have is a class
#                     wearing a different word.
#
#                     Note: this governs acquiring a pet, not loading one that
#                     already exists. A character saved with a pet before this
#                     was turned off still logs in with it, because the core
#                     reads the raw class id there. On a realm where no
#                     Skirmisher has ever had one, that case cannot arise.
#        Default:     0 - (No body type has a pet)
#                     1 - (Skirmishers may tame, as a stock hunter does)

Classless.Chassis.HunterPets = 0
