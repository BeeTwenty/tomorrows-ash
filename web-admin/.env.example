# ---------------------------------------------------------------------------
# Ashmorrow admin panel - configuration
#
# Copy to .env.local and fill in. `npm run gen-secret` prints the two keys.
# Nothing here has a working default: the panel has no demo mode and refuses to
# start when a control it depends on is missing.
# ---------------------------------------------------------------------------

# Where the panel is served from. Must be https when ADMIN_PUBLIC=1, or the
# session cookie could not be Secure and startup is refused.
ADMIN_SITE_URL=http://127.0.0.1:3010

# Declare it, do not let the panel guess. "Public" means reachable from
# somewhere you do not control. With it set, an allowlist and a trusted proxy
# become mandatory.
ADMIN_PUBLIC=0

# Comma-separated addresses or CIDR ranges allowed to reach the panel at all.
# IPv4 and IPv6. Required when ADMIN_PUBLIC=1.
#   ADMIN_IP_ALLOWLIST=203.0.113.7,198.51.100.0/24,2001:db8::/32
ADMIN_IP_ALLOWLIST=

# How many proxies YOU operate in front of the panel. X-Forwarded-For is
# written by the client, so hops are counted from the right and only this many
# are peeled. 0 means no forwarded header is trusted at all.
ADMIN_TRUSTED_PROXY_HOPS=0

# Alternatively, a header your proxy OVERWRITES on every request (not appends).
#   ADMIN_REAL_IP_HEADER=x-real-ip
ADMIN_REAL_IP_HEADER=

# Session bounds.
ADMIN_SESSION_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=30

# Failed sign-ins per address AND per username before both are refused.
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# `npm run gen-secret` prints both.
#   ADMIN_SESSION_SECRET - rotating it signs every staff member out. Safe.
#   ADMIN_TOTP_KEY       - rotating it invalidates every enrolled
#                          authenticator. Back it up.
ADMIN_SESSION_SECRET=
ADMIN_TOTP_KEY=

REALM_ID=1
REALM_NAME=Ashmorrow

# The panel's own database user. NOT the website's ash_web - see
# sql/admin-grants.sql for why the separation is the actual boundary.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ash_admin
DB_PASSWORD=
DB_AUTH=acore_auth
DB_CHARACTERS=acore_characters
DB_WORLD=acore_world
DB_ADMIN=ashmorrow_admin

# The worldserver's remote console. Optional: without it the panel refuses
# actions that need a running server rather than pretending to make them.
# Requires SOAP.Enabled = 1 in worldserver.conf. Never expose the port.
SOAP_ENABLED=0
SOAP_HOST=127.0.0.1
SOAP_PORT=7878
SOAP_USER=
SOAP_PASSWORD=
