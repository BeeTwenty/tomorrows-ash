# ---------------------------------------------------------------------------
# Tomorrow's Ash - website configuration
#
# Copy to .env.local and edit. NEVER commit .env.local; it holds credentials.
# Every value here has a safe default except SESSION_SECRET, which is required
# in production and has no sensible default.
#
#   cp .env.example .env.local
#   npm run gen-secret        # prints a SESSION_SECRET line to paste in
#
# See SETUP.md section 9 for a full walkthrough on Windows and Linux.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------

# Public address of this website. Used for password-reset links and for
# deciding whether cookies get the Secure attribute, so get it right in
# production. No trailing slash.
SITE_URL=http://localhost:3000

# Signs session cookies. Required in production, minimum 32 characters.
# Generate with: npm run gen-secret
SESSION_SECRET=

# live | demo | auto (default)
#   auto - live when DB_HOST is set, demo when it is not
#   demo - fully self-contained sample data, no database needed
DATA_SOURCE=auto

# --- Realm -----------------------------------------------------------------

REALM_ID=1
REALM_NAME=Ashmorrow

# What players put in realmlist.wtf, and what the status page probes.
REALM_ADDRESS=127.0.0.1
REALM_AUTH_PORT=3724
REALM_WORLD_PORT=8085

# Optional: probe a different host from the one advertised to players, e.g.
# when the site runs on the same LAN as the realm but players connect via WAN.
# REALM_AUTH_HOST=10.0.0.5
# REALM_WORLD_HOST=10.0.0.5

# How long a status probe is cached, in seconds.
REALM_STATUS_CACHE_SECONDS=30

# --- Database --------------------------------------------------------------
#
# One MySQL server holding AzerothCore's three schemas plus one of our own.
# Use a dedicated least-privilege user - SETUP.md section 9 has the exact
# GRANT statements. Never point this at root.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ash_web
DB_PASSWORD=
DB_CONNECTION_LIMIT=8

DB_AUTH=acore_auth
DB_CHARACTERS=acore_characters
DB_WORLD=acore_world

# Our own schema: sessions' reset tokens, rate limits, audit log.
# Created by web/sql/web-schema.sql. Never mixed into AzerothCore's tables.
DB_WEB=ashmorrow_web

# --- Accounts --------------------------------------------------------------

REGISTRATION_ENABLED=1

# account.expansion for new accounts: 0 classic, 1 TBC, 2 WotLK.
REGISTRATION_EXPANSION=2

# sql  - write SRP6 credentials directly (default; works while the realm is down)
# soap - delegate to the worldserver's `account create` console command
ACCOUNT_WRITE_MODE=sql

# One account per email address, so password reset is never ambiguous.
ACCOUNT_UNIQUE_EMAIL=1

PASSWORD_RESET_MINUTES=30

# How long a signed-in browser stays signed in.
SESSION_DAYS=14

# --- SOAP (optional) -------------------------------------------------------
#
# Only needed for ACCOUNT_WRITE_MODE=soap or live `server info`. Requires
# SOAP.Enabled=1 in worldserver.conf. Bind SOAP to localhost; never expose it.

SOAP_ENABLED=0
SOAP_HOST=127.0.0.1
SOAP_PORT=7878
SOAP_USER=
SOAP_PASSWORD=

# --- Mail ------------------------------------------------------------------
#
# console  - print reset links to the server log (fine for a homelab realm)
# smtp     - send properly
# disabled - turn password reset off entirely
MAIL_TRANSPORT=console
MAIL_FROM=Ashmorrow <no-reply@localhost>

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=

# --- Security --------------------------------------------------------------

# Enable ONLY behind a reverse proxy you control, so X-Forwarded-For can be
# trusted for rate limiting. With it off, requests without a trusted address
# share one bucket, which is stricter rather than looser.
TRUST_PROXY=0

# memory - per-process (correct for a single instance)
# mysql  - shared and restart-proof (needed behind several instances)
RATE_LIMIT_DRIVER=memory

# --- Classless budget ------------------------------------------------------
#
# These MUST match Classless.Points.* in the realm's mod_classless.conf. The
# module derives each character's point budget from their level and never
# stores it, so the armory computes the same curve to show "20 of 71 spent".
# Nothing can detect a mismatch for you - if you re-tune the realm's curve,
# change it here too.
#
#   budget = level < FirstLevel ? Bonus : (level - FirstLevel + 1) * PerLevel + Bonus

CLASSLESS_POINTS_FIRST_LEVEL=10
CLASSLESS_POINTS_PER_LEVEL=1
CLASSLESS_POINTS_BONUS=0

# --- Armory ----------------------------------------------------------------

# Hide characters on accounts with account_access.gmlevel >= this, site-wide.
# 0 disables the filter entirely.
ARMORY_HIDE_GM_LEVEL=1

LEADERBOARD_MIN_LEVEL=10
ARMORY_CACHE_SECONDS=60
