# Tomorrow's Ash - website database connection
#
# Copy to `.env` and fill in. NEVER commit the real .env.
# Create the user first:  python3 tools/ta.py db website-user

# --- Database host ---
# The MySQL server. For a website on the same homelab box as the realm this is
# 127.0.0.1; from another machine use the realm server's LAN IP and make sure
# MySQL is bound to it (bind-address in my.cnf) and port 3306 is reachable.
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Credentials ---
# Use the least-privilege website user, NOT the account the game server uses.
DB_USER=ashweb
DB_PASSWORD=CHANGE_ME

# --- Schemas ---
# Three separate databases. The website reads from all three but may only
# write to acore_auth.account.
DB_AUTH=acore_auth
DB_CHARACTERS=acore_characters
DB_WORLD=acore_world

# --- Realm ---
# Must match the `realmlist` row (tools/ta.py db realm).
REALM_ID=1
REALM_NAME=Ashmorrow
